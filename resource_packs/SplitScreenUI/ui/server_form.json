{
  "namespace": "server_form",

  // The menu of a player who has not been chosen yet (title "Choose your player") gets a black background over the whole of that player's part of
  // the screen, under the menu window, so a player who has not been chosen yet sees nothing of the world.
  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "splitscreen_black@server_form.splitscreen_black": {}
          }
        ]
      }
    ]
  },

  "splitscreen_black": {
    "type": "image",
    "texture": "textures/ui/Black",
    "size": [ 4000, 4000 ],
    "layer": 0,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text = 'Choose your player')",
        "target_property_name": "#visible"
      }
    ]
  }
}
