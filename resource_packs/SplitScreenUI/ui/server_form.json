          "anchor_to": "top_right",
          "offset": [ -6, -21 ],
          "layer": 20,
          "controls": [
            { "back@server_form.splitscreen_fill": { "color": [ 0.424, 0.765, 0.286 ] } },
            { "label": { "type": "label", "text": "Playing", "color": [ 0.118, 0.118, 0.122 ], "size": [ "default", "default" ], "anchor_from": "center", "anchor_to": "center", "layer": 1 } }
          ]
        }
      }
