  // Secondary (light), destructive (red) and primary (green) buttons of the game's new UI: outline, fill with a
  // light line on top and a dark edge below that sinks away when pressed; white outline when hovered or focused.
  "splitscreen_button@common.button": {
    "$square|default": false,
    "$pressed_button_name": "button.form_button_click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" } ],
    "controls": [
      { "default@server_form.splitscreen_button_look": { "$bg": "$tex", "$face_y": 2 } },
      { "hover@server_form.splitscreen_button_look": { "$bg": "$tex_hover", "$face_y": 2 } },
      { "pressed@server_form.splitscreen_button_look": { "$bg": "$tex_pressed", "$face_y": 4 } }
    ]
  },

  "splitscreen_button_look": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "bg": { "type": "image", "texture": "$bg", "size": [ "100%", "100%" ], "layer": 1 } },
      {
        "face": {
          "type": "panel",
          "size": [ "100% - 4px", "100% - 6px" ],
          "offset": [ 0, "$face_y" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 3,
          "controls": [
            {
              "icon": {
                "type": "image",
                "size": [ 16, 16 ],
                "offset": [ 5, 0 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "ignored": "$square",
                "bindings": [
                  { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "name": {
                "type": "label",
                "text": "#form_button_text",
                "color": "$text_color",
                "size": [ "default", "default" ],
                "offset": [ 26, 0 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "ignored": "$square",
                "bindings": [
                  { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(not (#form_button_text = 'Done'))", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "done_text": {
                "type": "label",
                "text": "Done",
                "color": "$text_color",
                "size": [ "default", "default" ],
                "layer": 2,
                "ignored": "$square",
                "bindings": [
                  { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(#form_button_text = 'Done')", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "square_icon": {
                "type": "image",
                "size": [ 16, 16 ],
                "layer": 2,
                "ignored": "(not $square)",
                "bindings": [
                  { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
                ]
              }
            }
          ]
        }
      }
    ]
  }
