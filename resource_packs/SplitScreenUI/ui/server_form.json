          "anchor_to": "top_right",
          "offset": [ -6, -21 ],
          "layer": 20,
          "controls": [
            { "back@server_form.splitscreen_fill": { "color": [ 0.549, 0.702, 1 ] } },
            { "label": { "type": "label", "text": "Player 1", "color": [ 0.118, 0.118, 0.122 ], "size": [ "default", "default" ], "anchor_from": "center", "anchor_to": "center", "layer": 1 } }
          ]
        }
      }
    ]
  },
  "splitscreen_tag_1": {
    "type": "panel",
    "size": [ "100%", 0 ],
    "bindings": [
