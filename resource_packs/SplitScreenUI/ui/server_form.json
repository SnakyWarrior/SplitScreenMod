    "type": "panel",
    "size": [ "100%", 0 ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(#form_button_text = '[p]')", "target_property_name": "#visible" }
    ],
    "controls": [ { "button@server_form.splitscreen_button": { "size": [ 26, 26 ], "anchor_from": "top_right", "anchor_to": "top_right", "offset": [ 0, -28 ], "$square": true, "$normal": [ 0.792, 0.212, 0.212 ], "$hover": [ 0.753, 0.176, 0.176 ], "$pressed": [ 0.678, 0.114, 0.114 ], "$edge": [ 0.678, 0.114, 0.114 ], "$shine": [ 1, 1, 1 ], "$text_color": [ 1, 1, 1 ] } } ]
  },

  // Secondary (light), destructive (red) and primary (green) buttons of the game's new UI: outline, fill with a
  // light line on top and a dark edge below that sinks away when pressed; white outline when hovered or focused.
  "splitscreen_button@common.button": {
    "$square|default": false,
    "$pressed_button_name": "button.form_button_click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" } ],
    "controls": [
      { "default@server_form.splitscreen_button_look": { "$fill": "$normal", "$frame": [ 0.12, 0.12, 0.12 ], "$sink": 0 } },
      { "hover@server_form.splitscreen_button_look": { "$fill": "$hover", "$frame": [ 1, 1, 1 ], "$sink": 0 } },
      { "pressed@server_form.splitscreen_button_look": { "$fill": "$pressed", "$frame": [ 0.12, 0.12, 0.12 ], "$sink": 4 } }
    ]
  },

  "splitscreen_button_look": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "frame@server_form.splitscreen_fill": { "color": "$frame", "layer": 1 } },
      { "edge@server_form.splitscreen_fill": { "color": "$edge", "size": [ "100% - 4px", "100% - 4px" ], "layer": 2 } },
      {
        "face": {
          "type": "panel",
          "size": [ "100% - 4px", "100% - 8px" ],
          "offset": [ 0, "$sink" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 3,
          "controls": [
            { "fill@server_form.splitscreen_fill": { "color": "$fill", "offset": [ 0, 2 ], "anchor_from": "top_middle", "anchor_to": "top_middle" } },
            { "spec_top@server_form.splitscreen_fill": { "color": [ 1, 1, 1 ], "alpha": 0.6, "size": [ "100%", 1 ], "offset": [ 0, 2 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 1 } },
            { "spec_left@server_form.splitscreen_fill": { "color": [ 1, 1, 1 ], "alpha": 0.6, "size": [ 1, "100%" ], "offset": [ 0, 2 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 1 } },
            { "spec_right@server_form.splitscreen_fill": { "color": [ 1, 1, 1 ], "alpha": 0.4, "size": [ 1, "100%" ], "offset": [ 0, 2 ], "anchor_from": "top_right", "anchor_to": "top_right", "layer": 1 } },
            { "spec_bottom@server_form.splitscreen_fill": { "color": [ 1, 1, 1 ], "alpha": 0.4, "size": [ "100%", 1 ], "anchor_from": "bottom_left", "anchor_to": "bottom_left", "offset": [ 0, 2 ], "layer": 1 } },
            {
              "icon": {
                "type": "image",
                "size": [ 16, 16 ],
                "offset": [ 5, 0 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "ignored": "$square",
                "bindings": [
                  { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "name": {
                "type": "label",
                "text": "#form_button_text",
                "color": "$text_color",
                "size": [ "default", "default" ],
                "offset": [ 26, 0 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "ignored": "$square",
                "bindings": [
                  { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(not (#form_button_text = 'Done'))", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "done_text": {
                "type": "label",
                "text": "Done",
                "color": "$text_color",
                "size": [ "default", "default" ],
                "layer": 2,
                "ignored": "$square",
                "bindings": [
                  { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(#form_button_text = 'Done')", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "square_icon": {
                "type": "image",
                "size": [ 14, 14 ],
                "layer": 2,
                "ignored": "(not $square)",
                "bindings": [
                  { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "square_x": {
                "type": "label",
                "text": "X",
                "color": [ 1, 1, 1 ],
                "size": [ "default", "default" ],
                "layer": 2,
                "ignored": "(not $square)",
                "bindings": [
                  { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(#form_button_text = '[x]')", "target_property_name": "#visible" }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
