        "pill": {
          "type": "panel",
          "size": [ 30, 13 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -94, -25 ],
          "layer": 20,
          "controls": [
            { "outline@server_form.splitscreen_fill": { "color": [ 0.118, 0.118, 0.122 ] } },
            { "back@server_form.splitscreen_fill": { "color": [0.424, 0.765, 0.286], "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } },
            { "label": { "type": "label", "text": "You", "color": [0.118, 0.118, 0.122], "size": [ "default", "default" ], "anchor_from": "center", "anchor_to": "center", "layer": 2 } }
          ]
        }
      }
    ]
  },
  "splitscreen_you_tag_1": {
    "type": "panel",
    "size": [ "100%", 0 ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(#form_button_text = '[syou]')", "target_property_name": "#visible" }
    ],
    "controls": [
      {
        "pill": {
          "type": "panel",
          "size": [ 30, 13 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -128, -25 ],
          "layer": 20,
          "controls": [
            { "outline@server_form.splitscreen_fill": { "color": [ 0.118, 0.118, 0.122 ] } },
            { "back@server_form.splitscreen_fill": { "color": [0.424, 0.765, 0.286], "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } },
            { "label": { "type": "label", "text": "You", "color": [0.118, 0.118, 0.122], "size": [ "default", "default" ], "anchor_from": "center", "anchor_to": "center", "layer": 2 } }
