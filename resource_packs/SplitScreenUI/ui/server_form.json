            { "back@server_form.splitscreen_fill": { "color": [ 1, 0.91, 0.4 ] } },
            { "label": { "type": "label", "text": "No controller", "color": [ 0.118, 0.118, 0.122 ], "size": [ "default", "default" ], "anchor_from": "center", "anchor_to": "center", "layer": 1 } }
