            { "back@server_form.splitscreen_fill": { "color": [ 0.549, 0.702, 1 ], "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } },
            { "label": { "type": "label", "text": "Player 1", "color": [ 0.118, 0.118, 0.122 ], "size": [ "default", "default" ], "anchor_from": "center", "anchor_to": "center", "layer": 2 } }
          ]
        }
