{
  "namespace": "server_form",

  // The mod's menus (titles "Bedrock Splitscreen" and "Choose your player") use the look of the game's new UI
  // instead of the classic form window: a grey panel, Minecraft Ten title, secondary (light) and destructive (red)
  // buttons,. "Choose your player" also gets a black background over the whole of that
  // player's part of the screen, so a player who has not been chosen yet sees nothing of the world.

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "splitscreen_black@server_form.splitscreen_black": {} },
          { "splitscreen_menu@server_form.splitscreen_menu": {} }
        ]
      }
    ]
  },

  // the classic window is hidden for the mod's menus
  "long_form": {
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text = 'Bedrock Splitscreen') or (#title_text = 'Choose your player')))",
        "target_property_name": "#visible"
      }
    ]
  },

  "splitscreen_black": {
    "type": "image",
    "texture": "textures/ui/Black",
    "size": [ 4000, 4000 ],
    "layer": 1,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text = 'Choose your player')",
        "target_property_name": "#visible"
      }
    ]
  },

  "splitscreen_fill": {
    "type": "image",
    "texture": "textures/ui/White",
    "size": [ "100%", "100%" ]
  },

  "splitscreen_menu": {
    "type": "panel",
    "size": [ 240, "100%c" ],
    "layer": 10,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text = 'Bedrock Splitscreen') or (#title_text = 'Choose your player'))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "background": {
          "type": "panel",
          "size": [ "100%", "100%sm" ],
          "controls": [
            { "outline@server_form.splitscreen_fill": { "color": [ 0.12, 0.12, 0.12 ], "layer": 0 } },
            { "panel@server_form.splitscreen_fill": { "color": [ 0.28, 0.29, 0.29 ], "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } }
          ]
        }
      },
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "100% - 14px", "100%c" ],
          "layer": 2,
          "controls": [
            { "top_pad": { "type": "panel", "size": [ "100%", 8 ] } },
            {
              "title": {
                "type": "label",
                "text": "#title_text",
                "font_type": "MinecraftTen",
                "color": [ 1, 1, 1 ],
                "size": [ "100%", "default" ]
              }
            },
            { "title_pad": { "type": "panel", "size": [ "100%", 3 ] } },
            {
              "text": {
                "type": "label",
                "text": "#form_text",
                "color": [ 0.82, 0.82, 0.83 ],
                "size": [ "100%", "default" ]
              }
            },
            { "text_pad": { "type": "panel", "size": [ "100%", 6 ] } },
            { "divider@server_form.splitscreen_fill": { "color": [ 0.19, 0.2, 0.2 ], "size": [ "100%", 1 ] } },
            { "divider_pad": { "type": "panel", "size": [ "100%", 6 ] } },
            {
              "rows": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100%", "100%c" ],
                "factory": {
                  "name": "buttons",
                  "control_ids": { "button": "server_form.splitscreen_row" }
                },
                "collection_name": "form_buttons",
                "bindings": [
                  { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" }
                ]
              }
            },
            { "bottom_pad": { "type": "panel", "size": [ "100%", 4 ] } }
          ]
        }
      }
    ]
  },

  // One row: a red "Remove ..." button or a light one, never both.
  "splitscreen_row": {
    "type": "panel",
    "size": [ "100%", 28 ],
    "controls": [
      {
        "light@server_form.splitscreen_button": {
          "$show_when": "(not (('%.7s' * #form_button_text) = 'Remove '))",
          "$normal": [ 0.82, 0.82, 0.83 ], "$hover": [ 0.93, 0.93, 0.94 ], "$pressed": [ 0.7, 0.7, 0.71 ],
          "$edge": [ 0.35, 0.35, 0.36 ], "$shine": [ 0.93, 0.93, 0.94 ], "$text_color": [ 0.19, 0.2, 0.2 ]
        }
      },
      {
        "red@server_form.splitscreen_button": {
          "$show_when": "(('%.7s' * #form_button_text) = 'Remove ')",
          "$normal": [ 0.79, 0.21, 0.21 ], "$hover": [ 1, 0.5, 0.5 ], "$pressed": [ 0.75, 0.17, 0.17 ],
          "$edge": [ 0.55, 0.1, 0.1 ], "$shine": [ 0.88, 0.36, 0.36 ], "$text_color": [ 1, 1, 1 ]
        }
      }
    ]
  },

  "splitscreen_button@common.button": {
    "size": [ "100%", 26 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$pressed_button_name": "button.form_button_click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "$show_when", "target_property_name": "#visible" }
    ],
    "controls": [
      { "default@server_form.splitscreen_button_look": { "$fill": "$normal", "$frame": [ 0.12, 0.12, 0.12 ], "$sink": 0 } },
      { "hover@server_form.splitscreen_button_look": { "$fill": "$hover", "$frame": [ 1, 1, 1 ], "$sink": 0 } },
      { "pressed@server_form.splitscreen_button_look": { "$fill": "$pressed", "$frame": [ 0.12, 0.12, 0.12 ], "$sink": 2 } }
    ]
  },

  // Outline, fill with a light line on top and a dark edge below (the edge sinks away when pressed), picture,
  // name and a status tag.
  "splitscreen_button_look": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "frame@server_form.splitscreen_fill": { "color": "$frame", "layer": 1 } },
      { "edge@server_form.splitscreen_fill": { "color": "$edge", "size": [ "100% - 2px", "100% - 2px" ], "layer": 2 } },
      {
        "face": {
          "type": "panel",
          "size": [ "100% - 2px", "100% - 5px" ],
          "offset": [ 0, "$sink" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 3,
          "controls": [
            { "fill@server_form.splitscreen_fill": { "color": "$fill", "offset": [ 0, 1 ], "anchor_from": "top_middle", "anchor_to": "top_middle" } },
            { "shine@server_form.splitscreen_fill": { "color": "$shine", "size": [ "100%", 1 ], "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [ 0, 1 ], "layer": 1 } },
            {
              "icon": {
                "type": "image",
                "size": [ 16, 16 ],
                "offset": [ 5, 0 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "bindings": [
                  { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
                ]
              }
            },
            {
              "name": {
                "type": "label",
                "text": "#form_button_text",
                "color": "$text_color",
                "size": [ "default", "default" ],
                "offset": [ 26, 0 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "bindings": [
                  { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
