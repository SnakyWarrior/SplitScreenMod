{
  "namespace": "server_form",

  // The mod's menus (titles "Split screen", "Who is playing?" and "Choose your player") use the look of the game's
  // new UI instead of the classic form window. The mod marks some buttons by their text:
  //   "[x]"           a red square with an X, laid over the right end of the row above (remove that player)
  //   "[p]"           a light square with a controller, laid over the row above (take player 1's controller)
  //   " name..."      (leading space) a row that leaves room on the right for such a square
  //   "Done"          the green closing button
  // "Choose your player" also gets a black background over that player's whole part of the screen, so a player who
  // has not been chosen yet sees nothing of the world, and a 10 second countdown (the mod closes it then).

  // full size (the game's is 0 x 0): the mouse only reaches controls inside their parent
  "main_screen_content": {
    "size": [ "100%", "100%" ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "splitscreen_black@server_form.splitscreen_black": {} },
          { "splitscreen_menu@server_form.splitscreen_menu": {} }
        ]
      }
    ]
  },

  // the classic window is hidden for the mod's menus
  "long_form": {
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text = 'Split screen') or (#title_text = 'Who is playing?') or (#title_text = 'Choose your player')))",
        "target_property_name": "#visible"
      }
    ]
  },

  "splitscreen_black": {
    "type": "image",
    "texture": "textures/ui/Black",
    "size": [ 4000, 4000 ],
    "layer": 1,
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'Choose your player')", "target_property_name": "#visible" }
    ]
  },

  "splitscreen_fill": {
    "type": "image",
    "texture": "textures/ui/White",
    "size": [ "100%", "100%" ]
  },

  "splitscreen_menu": {
    "type": "panel",
    "size": [ 300, "100%c" ],
    "layer": 10,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text = 'Split screen') or (#title_text = 'Who is playing?') or (#title_text = 'Choose your player'))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "background": {
          "type": "panel",
          "size": [ "100%", "100%sm" ],
          "controls": [
            { "outline@server_form.splitscreen_fill": { "color": [ 0.118, 0.118, 0.122 ], "layer": 0 } },
            { "panel@server_form.splitscreen_fill": { "color": [ 0.282, 0.286, 0.29 ], "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } }
          ]
        }
      },
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "100% - 14px", "100%c" ],
          "layer": 2,
          "controls": [
            { "top_pad": { "type": "panel", "size": [ "100%", 8 ] } },
            {
              "title_row": {
                "type": "panel",
                "size": [ "100%", 13 ],
                "controls": [
                  {
                    "title": {
                      "type": "label",
                      "text": "#title_text",
                      "font_type": "MinecraftTen",
                      "color": [ 1, 1, 1 ],
                      "size": [ "100% - 30px", "default" ],
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "bindings": [ { "binding_name": "#title_text" } ]
                    }
                  },
                  { "timer@server_form.splitscreen_timer": {} }
                ]
              }
            },
            { "title_pad": { "type": "panel", "size": [ "100%", 6 ] } },
            { "divider@server_form.splitscreen_fill": { "color": [ 0.19, 0.2, 0.2 ], "size": [ "100%", 1 ] } },
            { "divider_pad": { "type": "panel", "size": [ "100%", 6 ] } },
            {
              "rows": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100%", "100%c" ],
                "factory": {
                  "name": "buttons",
                  "control_ids": { "button": "server_form.splitscreen_row" }
                },
                "collection_name": "form_buttons",
                "bindings": [
                  { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" }
                ]
              }
            },
            { "bottom_pad": { "type": "panel", "size": [ "100%", 4 ] } }
          ]
        }
      }
    ]
  },

  // ---- countdown for "Choose your player": ten numbers, each shown for one second in turn ----
  "splitscreen_timer": {
    "type": "panel",
    "size": [ 22, 12 ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'Choose your player')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "frame@server_form.splitscreen_fill": { "color": [ 0.36, 0.36, 0.37 ], "layer": 0 } },
      { "back@server_form.splitscreen_fill": { "color": [ 0.12, 0.12, 0.12 ], "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } },
      { "n10@server_form.splitscreen_tick": { "text": "10", "anims": [ "@server_form.splitscreen_wait_0" ] } },
      { "n9@server_form.splitscreen_tick": { "text": "9", "anims": [ "@server_form.splitscreen_wait_1" ] } },
      { "n8@server_form.splitscreen_tick": { "text": "8", "anims": [ "@server_form.splitscreen_wait_2" ] } },
      { "n7@server_form.splitscreen_tick": { "text": "7", "anims": [ "@server_form.splitscreen_wait_3" ] } },
      { "n6@server_form.splitscreen_tick": { "text": "6", "anims": [ "@server_form.splitscreen_wait_4" ] } },
      { "n5@server_form.splitscreen_tick": { "text": "5", "anims": [ "@server_form.splitscreen_wait_5" ] } },
      { "n4@server_form.splitscreen_tick": { "text": "4", "anims": [ "@server_form.splitscreen_wait_6" ] } },
      { "n3@server_form.splitscreen_tick": { "text": "3", "color": [ 1, 0.5, 0.5 ], "anims": [ "@server_form.splitscreen_wait_7" ] } },
      { "n2@server_form.splitscreen_tick": { "text": "2", "color": [ 1, 0.5, 0.5 ], "anims": [ "@server_form.splitscreen_wait_8" ] } },
      { "n1@server_form.splitscreen_tick": { "text": "1", "color": [ 1, 0.5, 0.5 ], "anims": [ "@server_form.splitscreen_wait_9" ] } }
    ]
  },
  "splitscreen_tick": {
    "type": "label",
    "color": [ 1, 1, 1 ],
    "alpha": 0,
    "layer": 2,
    "size": [ "default", "default" ]
  },
  "splitscreen_wait_0": { "anim_type": "wait", "duration": 0, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_1": { "anim_type": "wait", "duration": 1, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_2": { "anim_type": "wait", "duration": 2, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_3": { "anim_type": "wait", "duration": 3, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_4": { "anim_type": "wait", "duration": 4, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_5": { "anim_type": "wait", "duration": 5, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_6": { "anim_type": "wait", "duration": 6, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_7": { "anim_type": "wait", "duration": 7, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_8": { "anim_type": "wait", "duration": 8, "next": "@server_form.splitscreen_show" },
  "splitscreen_wait_9": { "anim_type": "wait", "duration": 9, "next": "@server_form.splitscreen_show" },
  "splitscreen_show": { "anim_type": "alpha", "from": 1, "to": 1, "duration": 1, "next": "@server_form.splitscreen_hide" },
  "splitscreen_hide": { "anim_type": "alpha", "from": 0, "to": 0, "duration": 0.01 },

  // ---- one item of the form's buttons; exactly one of the variants below is shown ----
  "splitscreen_row": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" } ],
    "controls": [
      { "full@server_form.splitscreen_row_full": {} },
      { "narrow@server_form.splitscreen_row_narrow": {} },
      { "done@server_form.splitscreen_row_done": {} },
      { "kick@server_form.splitscreen_row_kick": {} },
      { "pad@server_form.splitscreen_row_pad": {} },
      { "header0@server_form.splitscreen_header_0": {} },
      { "header1@server_form.splitscreen_header_1": {} },
      { "tag0@server_form.splitscreen_tag_0": {} },
      { "tag1@server_form.splitscreen_tag_1": {} },
      { "tag2@server_form.splitscreen_tag_2": {} },
      { "tag3@server_form.splitscreen_tag_3": {} },
      { "stag0@server_form.splitscreen_stag_0": {} },
      { "stag1@server_form.splitscreen_stag_1": {} },
      { "stag2@server_form.splitscreen_stag_2": {} },
      { "stag3@server_form.splitscreen_stag_3": {} }
    ]
  },

  // section titles
  "splitscreen_header_0": {
    "type": "panel",
    "size": [ "100%", 14 ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(#form_button_text = '[h:Layout]')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "label": { "type": "label", "text": "Layout", "color": [ 0.82, 0.82, 0.83 ], "size": [ "default", "default" ], "anchor_from": "left_middle", "anchor_to": "left_middle" } }
    ]
  },
  "splitscreen_header_1": {
    "type": "panel",
    "size": [ "100%", 14 ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
