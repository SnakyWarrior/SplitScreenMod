          "size": [ 48, 13 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -6, -25 ],
          "layer": 20,
          "controls": [
            { "outline@server_form.splitscreen_fill": { "color": [ 0.118, 0.118, 0.122 ] } },
            { "back@server_form.splitscreen_fill": { "color": [ 0.424, 0.765, 0.286 ], "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } },
            { "label": { "type": "label", "text": "Playing", "color": [ 0.118, 0.118, 0.122 ], "size": [ "default", "default" ], "anchor_from": "center", "anchor_to": "center", "layer": 2 } }
          ]
        }
      }
    ]
  },
  "splitscreen_tag_2": {
    "type": "panel",
    "size": [ "100%", 0 ],
    "bindings": [
