      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(#form_button_text = '[tag:No controller]')", "target_property_name": "#visible" }
    ],
    "controls": [
