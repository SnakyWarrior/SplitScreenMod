{
  "namespace": "pause",

  // A square name-tag button in the row of small buttons under Save & Quit, styled like them. The mod handles
  // "button.splitscreen_menu".
  "smaller_buttons_panel/stacked_column": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_before",
        "where": { "control_name": "fill_3" },
        "value": [
          {
            "splitscreen_padding": {
              "type": "panel",
              "size": [ "2%", 0 ]
            }
          },
          {
            "splitscreen_small_button": {
              "type": "input_panel",
              "size": [ "100%c + 4px", 32 ],
              "controls": [ { "splitscreen_btn@pause.splitscreen_button_small_with_tooltip": {} } ]
            }
          }
        ]
      }
    ]
  },

  "splitscreen_icon": {
    "type": "image",
    "texture": "textures/items/name_tag",
    "layer": 3,
    "size": [ 16, 16 ]
  },

  "splitscreen_button_small@common_buttons.light_content_button": {
    "$pressed_button_name": "button.splitscreen_menu",
    "$focus_id": "icon_panel_main_focus",
    "focus_change_down": "return_to_game",
    "$button_tts_header": "Split screen",
    "size": [ 24, 24 ],
    "$button_content": "pause.splitscreen_icon",
    "$pressed_alpha": 0.65
  },

  "splitscreen_button_small_with_tooltip": {
    "type": "panel",
    "size": [ 24, 24 ],
    "controls": [
      { "button@pause.splitscreen_button_small": {} },
      { "tooltip_trigger@pause.icon_button_tooltip_trigger": { "$tooltip_text": "Split screen" } }
    ]
  }
}
